/*
 * Per-step Fractal task arguments.
 *
 * `ext.args` is a Map that is merged into the JSON passed to the Fractal task
 * via --args-json, so any argument of the task can be set here. Field names
 * follow the task's Pydantic models in fractal-tasks-core 2.1.0.
 */
process {

    withName: 'FRACTAL_IMPORT_OME_ZARR' {
        // merged into `advanced_options`
        ext.args = [
            add_image_roi_table  : true,
            update_omero_metadata: true,
            table_backend        : 'csv',
        ]
    }

    withName: 'FRACTAL_THRESHOLD_SEGMENTATION' {
        ext.args = {
            [
                segmentation_method: params.threshold_method == 'Simple Threshold'
                    ? [method: 'Simple Threshold', threshold: params.threshold as Double]
                    : [method: 'Otsu'],
                pre_post_process: [
                    pre_process : params.sigma_xy != null
                        ? [[type: 'Gaussian Blur Filter', sigma_xy: params.sigma_xy as Double]] : [],
                    post_process: params.min_size != null
                        ? [[type: 'Size Filter', min_size: params.min_size as Integer]] : [],
                ],
                // also write <label>_masking_ROI_table, usable by downstream Fractal tasks
                create_masking_roi_table: [mode: 'Create Masking ROI Table', table_backend: 'csv'],
            ]
        }
    }

    withName: 'FRACTAL_MEASURE_FEATURES' {
        // default features = shape + intensity on all channels
        ext.args = [:]
        // per-image feature tables as flat CSVs
        publishDir = [
            path   : { "${params.out_dir}/features" },
            mode   : 'copy',
            pattern: '*.csv',
        ]
    }

    withName: 'PUBLISH_OME_ZARR' {
        // every image of a plate writes into the same OME-Zarr, so the plate is
        // published once, after all of its images are done
        publishDir = [
            path: { "${params.out_dir}/ome_zarr" },
            mode: 'copy',
        ]
    }
}
