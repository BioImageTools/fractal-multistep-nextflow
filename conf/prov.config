/*
 * Run-level provenance, enabled with `-profile prov` (combine with an
 * execution profile, e.g. `-profile docker,prov`).
 *
 *   - nf-prov Workflow Run RO-Crate: the run, its parameters, every task with
 *     its inputs and outputs, and the published files (including each Fractal
 *     task's <meta.id>.<step>.args.json), in a standard format that
 *     WorkflowHub understands. It must sit in the published results folder,
 *     so it is written to ${params.out_dir}/ro-crate-metadata.json.
 *   - nf-prov BCO (BioCompute Object) and an HTML DAG of the run.
 *   - Nextflow trace/report/timeline for timing, resources and exit status.
 */

plugins {
    id 'nf-prov@1.8.0'
}

prov {
    enabled = true
    formats {
        wrroc {
            file      = "${params.out_dir}/ro-crate-metadata.json"
            overwrite = true
            // licence of the crate (the run's results); a crate without one is invalid
            license   = params.prov_license
            // person who ran the pipeline and their organisation ([:] = not given)
            agent        = params.prov_agent_name
                ? [name: params.prov_agent_name, orcid: params.prov_agent_orcid, email: params.prov_agent_email]
                : [:]
            organization = params.prov_organization_name
                ? [name: params.prov_organization_name, ror: params.prov_organization_ror]
                : [:]
            // publisher of the crate = the organisation (by ROR id), when given
            publisher    = params.prov_organization_ror ?: ''
        }
        bco {
            file      = "${params.out_dir}/pipeline_info/bco.json"
            overwrite = true
        }
        dag {
            file      = "${params.out_dir}/pipeline_info/dag.html"
            overwrite = true
        }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.out_dir}/pipeline_info/trace.tsv"
    // no `script`/`env`: they are multi-line and break the TSV
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,memory,accelerator,attempt,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar,workdir'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.out_dir}/pipeline_info/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.out_dir}/pipeline_info/timeline.html"
}
