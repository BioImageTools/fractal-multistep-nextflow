manifest {
    name            = 'fractal-multistep-nextflow'
    description     = 'Chaining several fractal-tasks-core tasks in one Nextflow workflow on OME-Zarr'
    author          = 'Tong LI'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
}

params {
    // [ meta, path-to-OME-Zarr ]: an HCS plate (processed image by image) or a
    // single image. meta may also carry `channel` / `label_name`.
    // data/PLK1_plate.zarr is built by scripts/make_test_plate.py
    images = [
        [ [id: 'PLK1_plate'], "${projectDir}/data/PLK1_plate.zarr" ],
    ]
    out_dir = 'results'

    // Segmentation (fractal-tasks-core threshold_segmentation)
    channel_mode     = 'index'   // 'index' | 'label' | 'wavelength_id'
    channel          = '0'
    label_name       = 'nuclei'
    threshold_method = 'Otsu'    // 'Otsu' | 'Simple Threshold'
    threshold        = null      // used only when threshold_method = 'Simple Threshold'
    sigma_xy         = 2.5       // Gaussian blur pre-processing; null to disable
    min_size         = 20        // drop objects smaller than this (pixels); null to disable

    // Image with fractal-tasks-core installed (see containers/Dockerfile)
    fractal_container = 'quay.io/bioinfotongli/fractal-tasks-core:2.1.0'
}

includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled = true
        // run as the calling user so files written into the OME-Zarr are not root-owned
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
    wave {
        // build the container on the fly from each module's environment.yml
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        wave.enabled   = true
        wave.strategy  = 'conda'
    }
    local {
        // use whatever `python` with fractal-tasks-core is already on PATH
    }
}
